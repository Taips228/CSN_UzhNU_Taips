  51:main.c        **** /* Timer interrupt for dynamic display */
  52:main.c        **** CY_ISR(Timer_Int_Handler2)
  53:main.c        **** {
  54:main.c        ****     FourDigit74HC595_sendOneDigit(led_counter, display_buffer[led_counter], 0);
  55:main.c        ****     led_counter++;
  56:main.c        ****     if(led_counter > 7) led_counter = 0;
  57:main.c        ****     
  58:main.c        ****     // Cyclic display update
  59:main.c        ****     cyclic_counter++;
  60:main.c        ****     if(cyclic_counter >= 500) {  // Adjust speed here
  61:main.c        ****         cyclic_counter = 0;
  62:main.c        ****         if(password_mode == 0) {
  63:main.c        ****             cyclicDisplay();
  64:main.c        ****         }
  65:main.c        ****     }
  66:main.c        **** }
