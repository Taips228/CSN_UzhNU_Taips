  92:main.c        ****     } else { 
  93:main.c        ****         FourDigit74HC595_sendData(LED_NUM[digit]); 
  94:main.c        ****     } 
  95:main.c        ****     Pin_Latch_Write(1);
  96:main.c        ****     Pin_Latch_Write(0); 
  97:main.c        **** } 
