  68:main.c        **** /* Send data to shift register */     
  69:main.c        **** static void FourDigit74HC595_sendData(uint8_t data) {     
  70:main.c        ****     for(uint8_t i = 0; i < 8; i++) {         
  71:main.c        ****         if(data & (0x80 >> i)) { 
  72:main.c        ****             Pin_DO_Write(1); 
  73:main.c        ****         } else { 
  74:main.c        ****             Pin_DO_Write(0); 
  75:main.c        ****         } 
  76:main.c        ****         Pin_CLK_Write(1); 
  77:main.c        ****         Pin_CLK_Write(0); 
  78:main.c        ****     } 
  79:main.c        **** } 
  80:main.c        **** 
  81:main.c        **** /* Send one digit to display */ 
  82:main.c        **** static void FourDigit74HC595_sendOneDigit(uint8_t position, uint8_t digit, uint8_t dot)  
  83:main.c        **** { 
  84:main.c        ****     if(position >= 8) {
  85:main.c        ****         FourDigit74HC595_sendData(0xFF); 
  86:main.c        ****         FourDigit74HC595_sendData(0xFF); 
  87:main.c        ****         return;
  88:main.c        ****     } 
ARM GAS  C:\Users\Maks\AppData\Local\Temp\cceSr4rh.s 			page 3


  89:main.c        ****     FourDigit74HC595_sendData(0xFF & ~(1 << position));     
  90:main.c        ****     if(dot) { 
